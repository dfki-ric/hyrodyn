prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: hyrodyn
Description: Hybrid Robot Dynamics library
Version: @PROJECT_VERSION@
Requires: rbdl eigen3 yaml-cpp
Libs: -L${libdir} -lhyrodyn
Cflags: -I${includedir} -I${includedir}/hyrodyn
